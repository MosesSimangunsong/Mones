# Backend
FLASK_DEBUG=0
FLASK_TESTING=0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
CORS_ORIGINS=*

# Market data
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://eodhd.com/api/real-time
MARKET_CACHE_TTL_SECONDS=900
MARKET_REQUEST_TIMEOUT_SECONDS=8
ENABLE_MARKET_MOCK_FALLBACK=true

# News
NEWS_PROVIDER=google_news_rss
NEWS_CACHE_TTL_SECONDS=900

# AI analysis
# Gunakan gemini untuk opsi gratis/free tier, atau openai jika ingin memakai OpenAI API.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
ANALYSIS_CACHE_TTL_SECONDS=86400
ENABLE_DEV_ANALYSIS_FALLBACK=1