/android/app/profile
/android/app/release
/android/.gradle/
/android/local.properties

# Python backend (see backend/.gitignore for details)
__pycache__/
.pytest_cache/
backend/.venv/
backend/pytest_temp/
backend/data/*.db

# Tool-generated, unrelated to this project
/.github/modernize/
